#exe {
-Mroot=main.zig
#}

#write main.zig {
const Foo = @Struct(.auto, null, &.{"reified_field"}, &.{void}, &.{.{}});
pub fn main(init: std.process.Init) !void {
    const field_name = @typeInfo(Foo).@"struct".field_names[0];
    try std.Io.File.stdout().writeStreamingAll(init.io, field_name ++ "\n");
}
const std = @import("std");
#}
#update
#check stdout {
reified_field
#}

